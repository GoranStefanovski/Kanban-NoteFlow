# ============================================
# Personal Notepad - Production Environment
# Domain: domain.com
# ============================================
# IMPORTANT: Update all values before deployment!
# ============================================

# MongoDB Configuration
# Keep this as-is for Docker deployment
MONGODB_URI=mongodb://mongodb:27017/personal-notepad

# JWT Configuration
# CRITICAL: Generate a strong secret using: openssl rand -base64 64
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_STRING_GENERATED_WITH_OPENSSL
JWT_EXPIRES_IN=7d

# Admin User Configuration
# IMPORTANT: Change these credentials immediately after first login!
ADMIN_EMAIL=admin@domain.com
ADMIN_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD

# SMTP Email Configuration
# For Gmail:
#   1. Enable 2FA on your Google account
#   2. Generate app password: https://myaccount.google.com/apppasswords
#   3. Use the 16-character app password below
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_NAME=Personal Notepad
SMTP_FROM_EMAIL=noreply@domain.com

# Application Configuration
PORT=3000
NODE_ENV=production

# Frontend API URL (used during build)
# This should match your domain
NEXT_PUBLIC_API_URL=https://domain.com/api
